{
  "name": "cabalmesh-contracts",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "typecheck:relay-settlement": "tsc --noEmit --project tsconfig.relay-settlement.json",
    "deploy:fuji": "hardhat run scripts/deploy.ts --network fuji",
    "deploy:marketplace": "hardhat run scripts/deployMarketplace.ts --network fuji",
    "deploy:relay-settlement": "hardhat run scripts/deployRelaySettlement.ts --network fuji",
    "smoke:relay-settlement": "hardhat run scripts/smokeRelaySettlementFuji.ts --network fuji"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "5.1.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.0",
    "typescript": "^5.6.2"
  }
}
