{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Main window on desktop. core:default already bundles app/event/image/menu/path/resources/tray/webview/window, so listing its members alongside it would be redundant rather than least privilege. App command permissions are generated from the COMMANDS list in build.rs \u2014 see capabilities/README.md. Desktop and mobile now share one frontend and one handler in lib.rs, so this grants exactly the same command set as mobile.json.",
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "allow-unsubscribe",
    "allow-session-status",
    "allow-enter-mesh",
    "allow-mesh-snapshot",
    "allow-subscribe-mesh-log",
    "allow-list-nearby-nodes",
    "allow-ble-status",
    "allow-market-modules",
    "allow-list-intents",
    "allow-intent-form-options",
    "allow-intent-affordability",
    "allow-propose-intent",
    "allow-preview-intent",
    "allow-broadcast-intent",
    "allow-intent-detail",
    "allow-subscribe-settlement-log",
    "allow-settle-intent",
    "allow-cancel-intent",
    "allow-intent-proof",
    "allow-vault-assets",
    "allow-vault-modules",
    "allow-module-loadout",
    "allow-equip-module",
    "allow-unequip-module",
    "allow-vault-identities",
    "allow-vault-keys",
    "allow-profile-summary",
    "allow-set-offline-mode"
  ]
}
