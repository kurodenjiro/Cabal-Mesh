{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Main webview on iOS and Android. Grants core only, plus the same app command set desktop.json grants \u2014 desktop and mobile share one frontend and one handler in lib.rs (src/mobile-entry), so there is no separate mobile-only screen set to scope this to. Permissions are generated from the COMMANDS list in build.rs \u2014 see capabilities/README.md.",
  "platforms": [
    "iOS",
    "android"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-ble-status",
    "allow-broadcast-intent",
    "allow-cancel-intent",
    "allow-enter-mesh",
    "allow-guardian-approve-unlock",
    "allow-guardian-candidates",
    "allow-guardian-deny-unlock",
    "allow-guardian-enroll",
    "allow-guardian-request-unlock",
    "allow-guardian-status",
    "allow-intent-detail",
    "allow-intent-form-options",
    "allow-intent-proof",
    "allow-list-intents",
    "allow-list-nearby-nodes",
    "allow-market-buy",
    "allow-market-list-module",
    "allow-market-listings",
    "allow-market-my-deals",
    "allow-market-refund-deal",
    "allow-market-release-deal",
    "allow-mesh-snapshot",
    "allow-parse-intent-chat",
    "allow-preview-intent",
    "allow-profile-summary",
    "allow-security-disable-passphrase",
    "allow-security-enable-passphrase",
    "allow-security-status",
    "allow-security-unlock",
    "allow-session-status",
    "allow-set-offline-mode",
    "allow-settle-intent",
    "allow-subscribe-mesh-log",
    "allow-subscribe-settlement-log",
    "allow-unsubscribe",
    "allow-vault-assets",
    "allow-vault-equip-module",
    "allow-vault-export-key",
    "allow-vault-identities",
    "allow-vault-import-key",
    "allow-vault-keys",
    "allow-vault-loadout",
    "allow-vault-modules",
    "allow-vault-redeem-module",
    "allow-vault-unequip-module"
  ]
}
