{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Main webview on iOS and Android. Mobile and desktop now share the same implemented screens and 22 least-privilege app commands; opener remains desktop-only. Never grant commands speculatively. See capabilities/README.md.",
  "platforms": [
    "iOS",
    "android"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-unsubscribe",
    "allow-session-status",
    "allow-enter-mesh",
    "allow-mesh-snapshot",
    "allow-subscribe-mesh-log",
    "allow-list-nearby-nodes",
    "allow-ble-status",
    "allow-list-intents",
    "allow-intent-form-options",
    "allow-propose-intent",
    "allow-preview-intent",
    "allow-broadcast-intent",
    "allow-intent-detail",
    "allow-subscribe-settlement-log",
    "allow-settle-intent",
    "allow-cancel-intent",
    "allow-intent-proof",
    "allow-vault-assets",
    "allow-vault-identities",
    "allow-vault-keys",
    "allow-profile-summary",
    "allow-set-offline-mode"
  ]
}
