{
  "name": "cabalmesh",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "ds:unbundle": "python3 scripts/unbundle-ds.py",
    "ds:types": "python3 scripts/generate-ds-types.py",
    "ds:assets": "python3 scripts/resample-ds-assets.py && python3 scripts/stage-ds-assets.py",
    "bindings": "cd src-tauri && cargo test --features ts-rs export_bindings --quiet",
    "bindings:check": "npm run bindings && git diff --exit-code -- src/types/bindings.ts",
    "ios:clean-build": "rm -rf src-tauri/gen/apple/build/arm64-sim src-tauri/gen/apple/build/arm64 src-tauri/gen/apple/build/*.xcarchive",
    "ios:sim": "npm run ios:clean-build && tauri ios build --debug --target aarch64-sim",
    "android:bundle": "tauri android build --aab",
    "android:size": "bash scripts/android-size.sh",
    "relay": "cd src-tauri && cargo run --release -p cabal-relay --",
    "ios:size": "bash scripts/ios-size.sh",
    "ble:check": "bash scripts/ble-link-check.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-opener": "2.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
